# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Neo4j (matches docker-compose.yml defaults) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ragchatbot123
NEO4J_DATABASE=neo4j
# Set to "false" to run without graph search if no Neo4j instance is reachable
GRAPH_SEARCH_ENABLED=true

# --- LangSmith (observability/tracing) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2-your-langsmith-key-here
LANGCHAIN_PROJECT=rag-chatbot

# --- DeepEval (answer relevancy / faithfulness scoring) ---
# Uses OPENAI_API_KEY above as the judge model by default.
DEEPEVAL_ENABLED=true
# Optional: only needed if you use Confident AI's hosted dashboard
CONFIDENT_API_KEY=

# --- App auth (left-panel login) ---
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=password@123

# --- Session tokens (JWT) ---
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_EXPIRE_MINUTES=120

# --- CORS: comma-separated list of allowed frontend origins ---
BACKEND_CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190

# --- OCR ---
# Windows: full path to tesseract.exe. Linux (VPS/apt-get install tesseract-ocr): leave blank, it's on PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
